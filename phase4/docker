Create our own custom image

	>> should create a new docker file 	
1. mkdir myImgs
2. cd myImgs
3. vi Dockerfile // name should be the same  [Dockerfile]
	type in Dockerfile the following
		FROM ubuntu
		MAINTAINER Subha
		RUN apt-get update
		RUN apt-get install git -y
		RUN apt-get install tree
		CMD ["echo","welcome to my image"]
		
4. sudo docker build . -t image-name:version_num // to run the docker file
5. sudo docker images // displayes all the images
6. sudo docker run -d subhakuru/subha-ubuntu:1.2.0 // to run the image
7. sudo docker run  subhakuru/subha-ubuntu:1.2.0 // will display the echo message
8. sudo docker push subhakuru/subha-ubuntu // to push image into docker hub

